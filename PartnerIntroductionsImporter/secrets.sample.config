<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE - copy this file to secrets.config (same folder) and fill in every value.
  secrets.config is git-ignored and is copied next to the exe on build.
  Run "PartnerIntroductionsImporter.exe --check-config" to confirm all settings are present.
-->
<appSettings>
  <!-- Microsoft Graph (app registration with Mail.ReadWrite on the Partner Introductions mailbox) -->
  <add key="GraphTenantId" value="" />
  <add key="GraphClientId" value="" />
  <add key="GraphClientSecret" value="" />

  <!-- Open GI / InStream -->
  <add key="InStreamBranch" value="" />
  <add key="InStreamMarsReference" value="" />
  <add key="InStreamBNumber" value="" />
  <add key="InStreamLicenceKey" value="" />

  <!-- SQL Server -->
  <add key="PhoneSystemConnectionString" value="Server=YOUR_SERVER;Database=Phone System;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;" />
  <add key="ThamesbankConnectionString" value="Server=YOUR_SERVER;Database=Thamesbank;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;" />
</appSettings>
